{
  "name": "@dfn/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ts-node/register/transpile-only -r tsconfig-paths/register --watch src/main.ts",
    "start": "node -r ts-node/register/transpile-only -r tsconfig-paths/register src/main.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi:export": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/export-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@dfn/compliance": "workspace:*",
    "@dfn/contracts": "workspace:*",
    "@dfn/database": "workspace:*",
    "@dfn/financial-ledger": "workspace:*",
    "@dfn/payment-adapters": "workspace:*",
    "@dfn/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "0.43.1",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "multer": "2.4.0",
    "nestjs-pino": "4.6.1",
    "otplib": "12.0.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/testing": "11.2.7",
    "@swc/core": "1.16.13",
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "autocannon": "8.0.0",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.1",
    "supertest": "7.3.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "unplugin-swc": "1.5.7",
    "vitest": "3.2.7"
  }
