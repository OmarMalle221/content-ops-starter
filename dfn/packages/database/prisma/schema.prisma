  updatedAt        DateTime             @updatedAt

  firstApprover  User?                 @relation("GateFirstApprover", fields: [firstApproverId], references: [id])
  secondApprover User?                 @relation("GateSecondApprover", fields: [secondApproverId], references: [id])
  events         RegulatoryGateEvent[]
}

model RegulatoryGateEvent {
  id          String                @id @default(uuid()) @db.Uuid
  gateCode    String
