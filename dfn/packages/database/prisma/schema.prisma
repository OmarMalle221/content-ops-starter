  createdAt   DateTime              @default(now())

  gate  RegulatoryGate @relation(fields: [gateCode], references: [code], onDelete: Cascade)
  actor User           @relation("GateEventActor", fields: [actorUserId], references: [id])

  @@index([gateCode, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 7 — KMS-managed data keys and document scanning
// ─────────────────────────────────────────────────────────────────────────────

/// Data-encryption key managed through a KMS (envelope encryption). Only the WRAPPED key (encrypted
/// by the KMS master key) is stored; the plaintext key only ever lives in API process memory.
/// Lifecycle: STAGED (decrypt-only while every replica loads it) → ACTIVE (seals new values) →
/// DECRYPT_ONLY (superseded, still opens old values) → RETIRED (no longer loaded).
model EncryptionKey {
  id              String              @id @default(uuid()) @db.Uuid
  /// Key purpose ("documents", "mfa", "webhooks", "beneficiaries").
  purpose         String
  /// Key id written in sealed values (unique per purpose, never "legacy").
  keyId           String
  status          EncryptionKeyStatus @default(STAGED)
  /// The data key encrypted by the KMS (opaque KMS ciphertext blob).
  wrappedKey      Bytes
  /// KMS provider that wrapped the key ("local", "aws").
  kmsProvider     String
  /// KMS master key reference used for wrapping (local key fingerprint, AWS key id / ARN).
  kmsKeyRef       String
  /// STAGED keys become ACTIVE no earlier than this instant (every replica has refreshed by then).
  activateAfter   DateTime?
  activatedAt     DateTime?
  deactivatedAt   DateTime?
  retiredAt       DateTime?
  createdByUserId String?             @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([purpose, keyId])
  @@index([purpose, status])
}

enum EncryptionKeyStatus {
  STAGED
  ACTIVE
  DECRYPT_ONLY
  RETIRED
}

enum DocumentScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
  SKIPPED
}
