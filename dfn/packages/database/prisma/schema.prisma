}

enum RegulatoryGateStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_SECOND_APPROVAL
  SATISFIED
  REVOKED
}

/// Regulatory gate (ROADMAP §10, R1–R10). Tracking only: satisfying a gate never switches the
/// platform out of sandbox — DFN_MODE stays "sandbox" in this code base.
model RegulatoryGate {
  code             String               @id
