  "passages": [
    {"id": "S1-P1", "source": "S1", "section": "Introduction", "texte": "Awa Exemple est une agronome fictive née en 1952 à Village-Test, utilisée uniquement pour tester le pipeline."},
    {"id": "S1-P2", "source": "S1", "section": "Biographie", "texte": "En 1977, elle fonde l'association Graines d'Essai, qui plante 30 000 arbres en dix ans."},
    {"id": "S1-P3", "source": "S1", "section": "Biographie", "texte": "Elle déclare : « Un arbre planté aujourd'hui est une promesse faite à demain. »"},
    {"id": "S1-P4", "source": "S1", "section": "Héritage", "texte": "En 2004, elle reçoit le prix fictif de l'Environnement pour son travail."},
    {"id": "S2-P1", "source": "S2", "section": "Wikidata", "texte": "Date de naissance : 3 mars 1952"}
