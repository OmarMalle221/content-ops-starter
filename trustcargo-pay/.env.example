# TrustCargo Pay — environment variables
# Copy to .env.local for local development. Never commit real secrets.

# demo | production. Production refuses to start with the mock payment provider.
TRUSTCARGO_MODE=demo

# Payment partner adapter. Only "mock" (simulation, no real money) exists in the MVP.
PAYMENT_PROVIDER=mock

# HMAC key for session cookies and signed document URLs (>= 32 random chars).
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Shared secret used by the (mock) partner to sign webhooks. In production: per-partner secret
# stored in the secret manager, referenced by provider_connections.webhook_secret_ref.
MOCK_PROVIDER_WEBHOOK_SECRET=

# Public base URL (used in invitation links).
APP_URL=http://localhost:3000

# Demo-only persona sign-in (ignored when TRUSTCARGO_MODE=production).
DEMO_ALLOW_PERSONA_LOGIN=true

# --- Supabase Auth / Storage (docs/DEPLOYMENT.md). Server-side only: never prefix with NEXT_PUBLIC_. ---
# Nothing has been tested against a real Supabase project from the development environment.
# demo | supabase. Production requires supabase (magic link + TOTP MFA at AAL2).
AUTH_PROVIDER=demo
# memory | supabase. Production requires supabase (private bucket, no Supabase signed URL ever reaches a browser).
STORAGE_PROVIDER=memory
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon key. Auth only, used by the server.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy service_role key. Storage only. Secret: keep it in the host's secret manager.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=trustcargo-documents
# Supabase Auth must allow the redirect URL  ${APP_URL}/auth/callback  (Authentication > URL Configuration).

# --- Not wired yet (see docs/PRODUCTION_READINESS.md) ---
# DATABASE_URL=                    # direct Postgres connection for the service layer
