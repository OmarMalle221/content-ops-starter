# TrustCargo Pay — environment variables
# Copy to .env.local for local development. Never commit real secrets. An empty value means "unset".
# As is, this file starts the pure in-memory persona demo (public demo secrets, fictitious data only).

# demo | production. Production refuses to start with the mock payment provider.
TRUSTCARGO_MODE=demo

# Payment partner adapter. Only "mock" (simulation, no real money) exists in the MVP.
PAYMENT_PROVIDER=mock

# HMAC key for session cookies and signed document URLs (>= 32 random chars).
# Generate with: openssl rand -base64 48
# REQUIRED with DATABASE_URL, AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase (the public demo fallback is
# refused there: it would let anyone forge sessions). Optional only for the pure in-memory persona demo.
SESSION_SECRET=

# Shared secret used by the (mock) partner to sign webhooks (>= 16 random chars; openssl rand -hex 24).
# REQUIRED with DATABASE_URL, AUTH_PROVIDER=supabase or STORAGE_PROVIDER=supabase (the public demo fallback would let
# anyone forge signed partner events). Optional only for the pure in-memory persona demo.
# In production: per-partner secret stored in the secret manager, referenced by provider_connections.webhook_secret_ref.
MOCK_PROVIDER_WEBHOOK_SECRET=

# Public base URL (used in invitation links).
APP_URL=http://localhost:3000

# Persona sign-in of the persona demo. Only honoured with TRUSTCARGO_MODE=demo AND AUTH_PROVIDER=demo: personas
# never sit next to real accounts (with AUTH_PROVIDER=supabase no persona is seeded and this is ignored).
DEMO_ALLOW_PERSONA_LOGIN=true

# Header holding the client IP, written by your platform's edge (rate limits, pseudonymised session events), e.g.
# fly-client-ip (Fly.io), cf-connecting-ip (Cloudflare), x-nf-client-connection-ip (Netlify), x-real-ip (nginx).
# Unset: the RIGHT-most X-Forwarded-For entry (the hop appended by the nearest proxy). Always run behind a proxy: an
# app exposed directly (e.g. a VM without a reverse proxy) sees a client-chosen X-Forwarded-For, so set this to a
# header your proxy overwrites, or put one in front. IPv6 clients are rate-limited per /64.
# CLIENT_IP_HEADER=

# --- Persistence ---
# Unset: in-memory database (per process, lost on restart, demo only).
# Set: PostgreSQL with the supabase/migrations schema (required in production). The first boot of an empty
# database in demo mode seeds it in one transaction (persona demo: personas + fictitious scenarios; Supabase
# accounts: reference data only); production never seeds. Requires SESSION_SECRET, MOCK_PROVIDER_WEBHOOK_SECRET
# and an explicit STORAGE_PROVIDER.
# DATABASE_URL=postgresql://user:password@db.<project-ref>.supabase.co:5432/postgres
# Role assumed in every unit of work (SET LOCAL ROLE): least privilege, no DDL. Default (and only value): service_role.
# DATABASE_ROLE=service_role
# Unit-of-work pool size. The simulated payment partner (schema trustcargo_sim, SIMULATION ONLY) uses its
# own pool of at most 2 more connections.
# DATABASE_POOL_MAX=5
# PEM CA certificate of the database server, REQUIRED for any host other than localhost / 127.0.0.1 / ::1 / a Unix
# socket (the app refuses to start without it). The server certificate is then always verified, and TLS settings in
# DATABASE_URL (ssl, sslmode…) are ignored; sslmode=disable|no-verify or ssl=0|false are refused.
# Supabase: Project Settings > Database > SSL Configuration > Download certificate. Paste the PEM content (not a
# path), on several lines or on one line with literal \n:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nMIID…\n-----END CERTIFICATE-----"

# --- Supabase Auth / Storage (docs/DEPLOYMENT.md). Server-side only: never prefix with NEXT_PUBLIC_. ---
# Nothing has been tested against a real Supabase project from the development environment.
# demo | supabase. demo = persona demo (fictitious personas only); supabase = real accounts (magic link + TOTP MFA at
# AAL2), never next to personas: a database is one or the other, and the app refuses to start on the wrong kind.
# Production requires supabase.
AUTH_PROVIDER=demo
# Sign-in e-mails per process and per hour, whatever the client (default 20). Size it BELOW the Supabase project's
# e-mail quota (Authentication > Rate Limits), minus what the other apps of a shared project need.
# MAGIC_LINK_HOURLY_CAP=20
# memory | supabase. Default memory without DATABASE_URL; with DATABASE_URL it must be set explicitly: supabase
# (private bucket, no Supabase signed URL ever reaches a browser), or memory for a demo only (document files are lost
# on restart and not shared between instances; logged at startup). Production requires supabase.
# STORAGE_PROVIDER=memory
# https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_…) or legacy anon key. Auth only, used by the server.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) or legacy service_role key. Storage only. Secret: keep it in the host's secret manager.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=trustcargo-documents
# Supabase Auth must allow the redirect URL  ${APP_URL}/auth/callback  (Authentication > URL Configuration).
