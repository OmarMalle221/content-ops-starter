---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig, pick } from '../../config/site.config';
import { useTranslations } from '../../i18n';
import { localeStaticPaths, pagePath } from '../../lib/paths';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.params;
const { t } = useTranslations(lang);
---

<BaseLayout lang={lang} page="services">
  <PageHeader title={t('services.title')} lead={t('services.lead')} />

  <div class="container-page section space-y-6">
    {
      siteConfig.services.map((service) => (
        <section id={service.id} aria-labelledby={`${service.id}-title`} class="card scroll-mt-24 sm:p-8">
          <div class="grid gap-6 lg:grid-cols-[1fr_1.1fr] lg:gap-10">
            <div>
              <span class="flex size-14 items-center justify-center rounded-xl bg-primary text-accent">
                <Icon name={service.icon} class="size-8" />
              </span>
              <h2 id={`${service.id}-title`} class="mt-4 text-2xl font-bold sm:text-3xl">
                {pick(service.title, lang)}
              </h2>
              <p class="mt-3 text-lg leading-relaxed">{pick(service.summary, lang)}</p>
              <a href={pagePath(lang, 'quote')} class="btn-accent mt-6" aria-label={`${t('services.askQuote')} : ${pick(service.title, lang)}`}>
                {t('cta.quote')}
                <Icon name="arrow" class="size-5" />
              </a>
            </div>
            <div class="rounded-xl bg-surface p-5 sm:p-6">
              <h3 class="eyebrow">{t('services.included')}</h3>
              <ul class="mt-4 space-y-3">
                {pick(service.included, lang).map((item) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-primary text-white">
                      <Icon name="check" class="size-4" />
                    </span>
                    <span class="leading-relaxed text-slate-800">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <CtaBand lang={lang} />
</BaseLayout>
