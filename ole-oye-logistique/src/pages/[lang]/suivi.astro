---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import TrackingForm from '../../components/TrackingForm.astro';
import { useTranslations } from '../../i18n';
import { localeStaticPaths } from '../../lib/paths';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.params;
const { t } = useTranslations(lang);
---

<BaseLayout lang={lang} page="tracking">
  <PageHeader title={t('tracking.title')} lead={t('tracking.lead')} />
  <div class="container-page section max-w-3xl">
    <TrackingForm lang={lang} />
  </div>
</BaseLayout>
