---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import TrustBar from '../../components/TrustBar.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import DestinationList from '../../components/DestinationList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { siteConfig } from '../../config/site.config';
import { useTranslations } from '../../i18n';
import { enabledItems, type FeatureName } from '../../lib/features';
import { localeStaticPaths, pagePath } from '../../lib/paths';

export const getStaticPaths = localeStaticPaths;

const { lang } = Astro.params;
const { t, tx } = useTranslations(lang);
const steps = enabledItems(tx<{ title: string; text: string; feature?: FeatureName }[]>('home.steps'));
---

<BaseLayout lang={lang} page="home">
  <Hero lang={lang} />
  <TrustBar lang={lang} />

  <section class="section" aria-labelledby="services-title">
    <div class="container-page">
      <p class="eyebrow">{t('home.servicesEyebrow')}</p>
      <h2 id="services-title" class="section-title mt-2">{t('home.servicesTitle')}</h2>
      <p class="mt-3 max-w-2xl text-lg">{t('home.servicesLead')}</p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {siteConfig.services.map((service) => <ServiceCard lang={lang} service={service} />)}
      </ul>
      <a href={pagePath(lang, 'services')} class="btn-outline mt-8">
        {t('cta.allServices')}
        <Icon name="arrow" class="size-5" />
      </a>
    </div>
  </section>

  <section class="section bg-surface" aria-labelledby="steps-title">
    <div class="container-page">
      <p class="eyebrow">{t('home.stepsEyebrow')}</p>
      <h2 id="steps-title" class="section-title mt-2">{t('home.stepsTitle')}</h2>
      <ol class:list={['mt-8 grid gap-4 sm:grid-cols-2', steps.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
        {
          steps.map((step, index) => (
            <li class="card">
              <span class="flex size-10 items-center justify-center rounded-full bg-accent font-display text-lg font-extrabold text-primary-dark">
                {index + 1}
              </span>
              <h3 class="mt-4 text-lg font-bold">{step.title}</h3>
              <p class="mt-1.5 leading-relaxed">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="destinations-title">
    <div class="container-page">
      <p class="eyebrow">{t('home.destinationsEyebrow')}</p>
      <h2 id="destinations-title" class="section-title mt-2">{t('home.destinationsTitle')}</h2>
      <p class="mt-3 max-w-2xl text-lg">{t('home.destinationsLead')}</p>
      <div class="mt-8">
        <DestinationList lang={lang} limit={8} />
      </div>
      <a href={pagePath(lang, 'destinations')} class="btn-outline mt-8">
        {t('cta.allDestinations')}
        <Icon name="arrow" class="size-5" />
      </a>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>
