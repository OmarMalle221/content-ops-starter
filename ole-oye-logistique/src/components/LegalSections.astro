---
import { enabledTexts, type FeatureItem } from '../lib/features';

interface Props {
  /** Un paragraphe peut être réservé à une fonctionnalité : il disparaît quand elle est désactivée. */
  sections: { title: string; body: FeatureItem[] }[];
}

const { sections } = Astro.props;
---

<div class="space-y-9">
  {
    sections.map((section) => (
      <section>
        <h2 class="text-2xl font-bold">{section.title}</h2>
        {enabledTexts(section.body).map((paragraph) => (
          <p class="mt-3 text-lg leading-relaxed">{paragraph}</p>
        ))}
      </section>
    ))
  }
</div>
