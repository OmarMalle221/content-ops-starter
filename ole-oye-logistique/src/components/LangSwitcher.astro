---
import { siteConfig } from '../config/site.config';
import { useTranslations } from '../i18n';
import { pagePath, type PageKey } from '../lib/paths';

interface Props {
  lang: string;
  page: PageKey;
}

const { lang, page } = Astro.props;
const { t } = useTranslations(lang);
---

<nav aria-label={t('nav.language')}>
  <ul class="flex items-center rounded-lg border border-slate-300 p-0.5 text-sm font-semibold">
    {
      siteConfig.locales.map((locale) => (
        <li>
          <a
            href={pagePath(locale.code, page)}
            hreflang={locale.htmlLang}
            lang={locale.htmlLang}
            aria-current={locale.code === lang ? 'true' : undefined}
            title={locale.label}
            class:list={[
              'flex min-h-9 min-w-10 items-center justify-center rounded-md px-2 uppercase',
              locale.code === lang ? 'bg-primary text-white' : 'text-slate-700 hover:bg-primary-soft',
            ]}
          >
            <span aria-hidden="true">{locale.code}</span>
            <span class="sr-only">{locale.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
