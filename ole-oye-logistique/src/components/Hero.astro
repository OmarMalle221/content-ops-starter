---
import Icon from './Icon.astro';
import RouteArt from './RouteArt.astro';
import { useTranslations } from '../i18n';
import { pagePath } from '../lib/paths';
import { whatsappLink } from '../lib/whatsapp';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<section class="bg-linear-to-br from-primary to-primary-dark text-white">
  <div class="container-page grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1.15fr_1fr] lg:py-24">
    <div>
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">{t('home.eyebrow')}</p>
      <h1 class="mt-3 text-4xl leading-[1.1] font-extrabold text-white sm:text-5xl lg:text-[3.4rem]">
        {t('home.title')}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-slate-200">{t('home.lead')}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={pagePath(lang, 'quote')} class="btn-accent">
          {t('cta.quote')}
          <Icon name="arrow" class="size-5" />
        </a>
        <a href={whatsappLink(t('cta.whatsappMessage'))} class="btn-whatsapp" rel="noopener">
          <Icon name="whatsapp" class="size-5" />
          {t('cta.whatsapp')}
        </a>
      </div>
      <a
        href={pagePath(lang, 'tracking')}
        class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
      >
        <Icon name="search" class="size-5" />
        {t('cta.track')}
      </a>
    </div>
    <RouteArt fromLabel={t('home.routeFrom')} toLabel={t('home.routeTo')} />
  </div>
</section>
