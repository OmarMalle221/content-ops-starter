---
import Icon from './Icon.astro';
import { pick, type Service } from '../config/site.config';
import { pagePath } from '../lib/paths';

interface Props {
  lang: string;
  service: Service;
}

const { lang, service } = Astro.props;
---

<li class="card group relative flex h-full flex-col transition-shadow hover:shadow-md">
  <span class="flex size-12 items-center justify-center rounded-xl bg-primary-soft text-primary">
    <Icon name={service.icon} class="size-7" />
  </span>
  <h3 class="mt-4 text-xl font-bold">
    <a href={`${pagePath(lang, 'services')}#${service.id}`} class="after:absolute after:inset-0 after:rounded-2xl">
      {pick(service.title, lang)}
    </a>
  </h3>
  <p class="mt-2 leading-relaxed">{pick(service.summary, lang)}</p>
  <span class="mt-auto flex justify-end pt-4 text-accent-text transition-transform group-hover:translate-x-1" aria-hidden="true">
    <Icon name="arrow" class="size-5" />
  </span>
</li>
