---
/**
 * Illustration de l'accueil : la route maritime du port de départ vers les
 * destinations de la config. Dessin vectoriel, aucun fichier image à charger.
 */
import { siteConfig } from '../config/site.config';

interface Props {
  fromLabel: string;
  toLabel: string;
}

const { fromLabel, toLabel } = Astro.props;
const featured = siteConfig.destinations.slice(0, 4);
---

<div class="rounded-3xl border border-white/15 bg-white/5 p-5 sm:p-6">
  <svg viewBox="0 0 400 190" class="w-full" aria-hidden="true">
    <defs>
      <linearGradient id="route-line" x1="0" x2="1">
        <stop offset="0" stop-color="var(--brand-accent)" stop-opacity="0.35"></stop>
        <stop offset="1" stop-color="var(--brand-accent)"></stop>
      </linearGradient>
    </defs>
    <!-- Vagues -->
    <g fill="none" stroke="#fff" stroke-opacity="0.12" stroke-width="2" stroke-linecap="round">
      <path d="M20 150c20-10 40-10 60 0s40 10 60 0 40-10 60 0 40 10 60 0 40-10 60 0 40 10 60 0"></path>
      <path d="M0 172c20-10 40-10 60 0s40 10 60 0 40-10 60 0 40 10 60 0 40-10 60 0 40 10 60 0 40-10 60 0"></path>
    </g>
    <!-- Route -->
    <path d="M48 62C130 4 270 20 352 118" fill="none" stroke="url(#route-line)" stroke-width="3" stroke-dasharray="2 9" stroke-linecap="round"></path>
    <!-- Navire -->
    <g transform="translate(196 22)" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M-22 12h44l-5 10h-34z" fill="var(--brand-primary)"></path>
      <path d="M-15 12V2h30v10" fill="var(--brand-primary)"></path>
      <path d="M-9 2V-6h7v8M2 2V-6h7v8" stroke="var(--brand-accent)"></path>
    </g>
    <!-- Départ -->
    <circle cx="48" cy="62" r="13" fill="var(--brand-accent)" fill-opacity="0.2"></circle>
    <circle cx="48" cy="62" r="6" fill="var(--brand-accent)"></circle>
    <!-- Arrivée -->
    <circle cx="352" cy="118" r="13" fill="#fff" fill-opacity="0.18"></circle>
    <circle cx="352" cy="118" r="6" fill="#fff"></circle>
  </svg>

  <dl class="mt-2 grid grid-cols-2 gap-4 text-sm">
    <div>
      <dt class="font-semibold tracking-wide text-accent uppercase">{fromLabel}</dt>
      <dd class="mt-1 font-display text-lg font-bold text-white">{siteConfig.origin.city}</dd>
      <dd class="text-slate-300">{siteConfig.origin.port}</dd>
    </div>
    <div class="text-right">
      <dt class="font-semibold tracking-wide text-accent uppercase">{toLabel}</dt>
      <dd class="mt-1 font-display text-lg font-bold text-white">{featured.slice(0, 2).map((d) => d.city).join(' · ')}</dd>
      <dd class="text-slate-300">{featured.slice(2).map((d) => d.city).join(' · ')}…</dd>
    </div>
  </dl>
</div>
