{
    "name": "relais",
    "version": "0.1.0",
    "private": true,
    "description": "Relais — coordination des soins d'un parent et navigation des droits pour les proches aidants du Québec (pilote v0.1)",
    "type": "module",
    "engines": {
        "node": ">=22.19"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:db": "bash scripts/test-db.sh",
        "test:ai-live": "vitest run --project integration",
        "test:e2e": "playwright test",
        "generate:reference": "node scripts/generate-reference-sql.mjs",
        "check:reference": "node scripts/generate-reference-sql.mjs --check"
    },
    "dependencies": {
        "@fontsource/atkinson-hyperlegible": "5.3.0",
        "@supabase/supabase-js": "2.117.2",
        "@tanstack/react-query": "5.104.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "7.18.4",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "1.3.0",
        "@axe-core/playwright": "4.13.0",
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.63.0",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.7",
        "@types/node": "22.20.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "9.39.5",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "16.5.0",
        "jsdom": "30.1.1",
        "lighthouse": "13.4.1",
        "pg": "8.23.1",
        "playwright-core": "1.63.0",
        "prettier": "3.9.9",
        "tailwindcss": "4.3.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.0",
        "unpdf": "1.9.1",
        "vite": "8.3.4",
        "vite-plugin-pwa": "2.0.0",
        "vitest": "5.0.3",
        "workbox-build": "7.4.1",
        "workbox-window": "7.4.1"
    }
}
